{
  "name": "alfanso-portfolio-new",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "alchemy:profile:edit": "alchemy profile edit",
    "build": "turbo run build",
    "cf:deploy": "alchemy deploy --stage prod --env-file .env",
    "cf:deploy:plan": "alchemy deploy --stage prod --env-file .env --dry-run",
    "cf:login": "pnpm --filter @alfanso/api exec wrangler login",
    "check": "ultracite check",
    "db:migrate:local": "pnpm --filter @alfanso/api db:migrate:local",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "lint": "turbo run lint",
    "media:upload": "node scripts/upload-public-images.mjs",
    "media:upload:local": "node scripts/upload-public-images.mjs --local",
    "prepare": "lefthook install",
    "preview": "pnpm --filter @alfanso/web preview"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-rc.118",
    "@effect/platform-node": "^4.0.0-rc.118",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "alchemy": "^2.0.0-beta.81",
    "effect": "^4.0.0-rc.118"
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "turbo": "^2.5.6",
    "ultracite": "^7.8.4"
  },
  "packageManager": "pnpm@10.20.0"
}
