{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "linter": {
    "rules": {
      "style": {
        "useAtIndex": "off"
      },
      "correctness": {
        "useImageSize": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/web/src/Components/background/dither.tsx",
        "apps/web/src/features/tech-stack/components/exel.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAttribute": "off"
          }
        }
      }
    }
  ]
}
